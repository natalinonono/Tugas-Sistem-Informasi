# ========================================================
# KONFIGURASI DATABASE KHUSUS PHP NATIVE
# SiDinar Regina - Sistem Informasi & Presensi Putra-Putri Altar
# ========================================================

# 1. Konfigurasi MySQL Lokal XAMPP (Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=sidinar_db

# 2. Konfigurasi Project Supabase Khusus PHP Native
# (Buat project baru di https://supabase.com, lalu masukkan kredensialnya di sini)
SUPABASE_URL=https://YOUR_NEW_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_NEW_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_SUPABASE_SERVICE_ROLE_KEY

# 3. Konfigurasi Direct PostgreSQL Supabase (Opsional jika pakai PDO)
SUPABASE_DB_HOST=db.YOUR_NEW_PROJECT_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASS=YOUR_SUPABASE_DB_PASSWORD
